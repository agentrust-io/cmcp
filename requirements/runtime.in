# Runtime dependencies only, mirroring [project.dependencies]. Used where the
# package is installed for use rather than for development: the container
# image and the ClusterFuzzLite build. Both install this lock with
# --require-hashes first and then the package itself with --no-deps.
# Constrained to requirements/dev.txt so the image runs the versions CI tested.
# Compile with:
#   uv pip compile requirements/runtime.in -c requirements/dev.txt \
#     --generate-hashes --universal --python-version 3.11 -o requirements/runtime.txt
